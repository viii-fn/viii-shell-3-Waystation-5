#!/usr/bin/env python3
"""viii-news: today's Linux + PlayStation news (only items with a picture) -> ~/.cache/viii/news/

  viii-news            fetch once per calendar day (does nothing if today's cache exists)
  viii-news --force    fetch now
  viii-news --test     only check the feeds and print what each one gives (writes nothing)

Cache: ~/.cache/viii/news/news.json and ~/.cache/viii/news/img/*.jpg
Old pictures are deleted only after a new batch has been written. If the fetch fails, the old cache stays.
Exit 0 = cache is current, 1 = failed (the old cache is left alone)."""
import hashlib, html, json, os, re, shutil, subprocess, sys, time
import urllib.parse, urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime

BASE = os.environ.get("VIII_CACHE") or os.path.expanduser("~/.cache/viii")
DIR = BASE + "/news"
IMG = DIR + "/img"
OUT = DIR + "/news.json"
UA = "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0 viii-shell"
PER_GROUP = 4          # cards per group (Linux / PlayStation), 8 in total
MAX_OG = 8             # at most this many article pages are opened to look for a picture
DEADLINE = time.time() + 150

# (group, source name, feed url). Edit freely: any RSS or Atom feed works.
FEEDS = [
    ("Linux", "9to5Linux", "https://9to5linux.com/feed"),
    ("Linux", "Phoronix", "https://www.phoronix.com/rss.php"),
    ("Linux", "OMG! Ubuntu", "https://www.omgubuntu.co.uk/feed"),
    ("PlayStation", "PlayStation Blog", "https://blog.playstation.com/feed/"),
    ("PlayStation", "Push Square", "https://www.pushsquare.com/feeds/latest"),
    ("PlayStation", "PlayStation LifeStyle", "https://www.playstationlifestyle.net/feed/"),
]

BAD_IMG = ("gravatar", "avatar", "emoji", "/logo", "logo.", "pixel", "1x1", "spacer", "blank.", ".svg", ".gif",
           "feedburner", "doubleclick")
IM = shutil.which("magick") or shutil.which("convert")


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def get(url, timeout=10, limit=None):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read(limit) if limit else r.read()


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def ln(tag):
    return tag.rsplit("}", 1)[-1] if isinstance(tag, str) else ""


def child_text(el, name):
    for c in el:
        if ln(c.tag) == name and (c.text or "").strip():
            return c.text
    return ""


def parse_date(s):
    s = (s or "").strip()
    if not s:
        return 0
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        pass
    try:
        d = datetime.fromisoformat(s.replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return int(d.timestamp())
    except Exception:
        return 0


def clean_text(raw, n=None):
    s = re.sub(r"<[^>]+>", " ", raw or "")
    s = html.unescape(s)
    s = re.sub(r"\s+", " ", s).strip()
    s = re.sub(r"\s*(The post .{0,200}? appeared first on .*|\[(\u2026|\.\.\.)\].*|Read more.*|Continue reading.*)$", "", s).strip()
    if n and len(s) > n:
        s = s[:n].rsplit(" ", 1)[0].rstrip(",.;:- ") + "\u2026"
    return s


def good_img(u):
    u = (u or "").strip()
    if not (u.startswith("http://") or u.startswith("https://")):
        return False
    low = u.lower()
    return not any(b in low for b in BAD_IMG)


def item_image(el, body):
    for c in el.iter():
        n = ln(c.tag)
        u = c.get("url")
        if not u:
            continue
        typ = c.get("type", "")
        if n == "thumbnail" or (n == "enclosure" and typ.startswith("image")):
            if good_img(u):
                return u.strip()
        elif n == "content":
            if c.get("medium") == "image" or typ.startswith("image") or re.search(r"\.(jpe?g|png|webp)(\?|$)", u, re.I):
                if good_img(u):
                    return u.strip()
    for m in re.finditer(r"<img[^>]+src=[\"']([^\"']+)[\"']", body or "", re.I):
        u = html.unescape(m.group(1))
        if good_img(u):
            return u.strip()
    return ""


def parse_feed(data, group, source):
    root = ET.fromstring(data)
    out = []
    for el in root.iter():
        if ln(el.tag) not in ("item", "entry"):
            continue
        title = clean_text(child_text(el, "title"))
        link = ""
        for c in el:
            if ln(c.tag) == "link":
                h = (c.get("href") or c.text or "").strip()
                if h and c.get("rel") in (None, "alternate"):
                    link = h
                    break
        if not title or not (link.startswith("http://") or link.startswith("https://")):
            continue
        body = child_text(el, "encoded") or child_text(el, "content")
        desc = child_text(el, "description") or child_text(el, "summary") or body
        ts = 0
        for k in ("pubDate", "published", "updated", "date"):
            ts = parse_date(child_text(el, k))
            if ts:
                break
        summary = clean_text(desc or body, 240)
        if summary.lower() == title.lower():
            summary = ""
        out.append({"title": title, "link": link, "summary": summary, "ts": ts,
                    "img_url": item_image(el, (body or "") + " " + (desc or "")),
                    "source": source, "group": group})
    return out


def og_image(link):
    try:
        page = get(link, 10, 200000).decode("utf-8", "replace")
    except Exception:
        return ""
    pats = (
        r"<meta[^>]+(?:property|name)=[\"']og:image(?::secure_url)?[\"'][^>]*?content=[\"']([^\"']+)",
        r"<meta[^>]+content=[\"']([^\"']+)[\"'][^>]*?(?:property|name)=[\"']og:image[\"']",
    )
    for pat in pats:
        m = re.search(pat, page, re.I)
        if m:
            u = urllib.parse.urljoin(link, html.unescape(m.group(1)))
            if good_img(u):
                return u
    return ""


def make_image(url, dest):
    """Download, shrink to 1280 px wide at most, save as jpg. False if it fails or is too small."""
    try:
        raw = get(url, 12, 8000001)
    except Exception:
        return False
    if len(raw) > 8000000 or len(raw) < 4000:
        return False
    tmp = dest + ".part"
    try:
        with open(tmp, "wb") as f:
            f.write(raw)
        if not IM:
            os.replace(tmp, dest)
            return True
        r = subprocess.run([IM, tmp + "[0]", "-auto-orient", "-resize", "1280x>", "-strip", "-quality", "82", "jpg:" + dest],
                           capture_output=True, timeout=40)
        if r.returncode != 0 or not os.path.exists(dest) or os.path.getsize(dest) < 3000:
            return False
        w = subprocess.run([IM, dest, "-format", "%w", "info:"], capture_output=True, timeout=20, text=True).stdout.strip()
        if not w.isdigit() or int(w) < 480:
            os.remove(dest)
            return False
        return True
    except Exception:
        return False
    finally:
        try:
            os.remove(tmp)
        except Exception:
            pass


def prune(keep):
    try:
        for f in os.listdir(IMG):
            if f not in keep:
                try:
                    os.remove(IMG + "/" + f)
                except Exception:
                    pass
    except Exception:
        pass


def test():
    print("viii-news feed test (no pictures downloaded)\n")
    ok = 0
    for group, source, url in FEEDS:
        try:
            items = parse_feed(get(url), group, source)
            pics = sum(1 for i in items if i["img_url"])
            print("  OK    %-22s %-12s %2d items, %2d with a picture in the feed" % (source, group, len(items), pics))
            ok += 1
        except Exception as e:
            print("  FAIL  %-22s %-12s %s" % (source, group, str(e)[:70]))
    print("\nresizer: %s" % (IM or "none found (pictures are kept as downloaded)"))
    print("%d of %d feeds answered" % (ok, len(FEEDS)))
    return 0 if ok else 1


def build():
    pools = {"Linux": [], "PlayStation": []}
    for group, source, url in FEEDS:
        try:
            items = parse_feed(get(url), group, source)
        except Exception as e:
            log("  %s: failed (%s)" % (source, str(e)[:60]))
            continue
        log("  %s: %d items" % (source, len(items)))
        pools[group] += items
    os.makedirs(IMG, exist_ok=True)
    chosen = {}
    titles = set()
    for group, pool in pools.items():
        pool.sort(key=lambda i: -i["ts"])
        got, per, tried, og_left = [], {}, set(), MAX_OG
        for relax in (False, True):
            for it in pool:
                if len(got) >= PER_GROUP or time.time() > DEADLINE:
                    break
                if it["link"] in tried:
                    continue
                if not relax and per.get(it["source"], 0) >= 2:
                    continue
                tried.add(it["link"])
                tkey = it["title"].lower()
                if tkey in titles:
                    continue
                url = it["img_url"]
                if not url and og_left > 0:
                    og_left -= 1
                    url = og_image(it["link"])
                if not url:
                    continue
                dest = IMG + "/" + hashlib.sha1(it["link"].encode()).hexdigest()[:12] + ".jpg"
                if not (os.path.exists(dest) and os.path.getsize(dest) > 3000):
                    if not make_image(url, dest):
                        continue
                it["img"] = dest
                got.append(it)
                titles.add(tkey)
                per[it["source"]] = per.get(it["source"], 0) + 1
        chosen[group] = got
        log("  %s: %d picked" % (group, len(got)))
    a, b = chosen["Linux"], chosen["PlayStation"]
    first_a = (a[0]["ts"] if a else 0) >= (b[0]["ts"] if b else 0)
    out = []
    i = 0
    while i < len(a) or i < len(b):
        pair = (a, b) if first_a else (b, a)
        for lst in pair:
            if i < len(lst):
                out.append(lst[i])
        i += 1
    for it in out:
        it.pop("img_url", None)
    return out


def main():
    args = sys.argv[1:]
    if "--test" in args:
        return test()
    today = time.strftime("%Y-%m-%d")
    old = read_json(OUT)
    if "--force" not in args and old and old.get("date") == today and len(old.get("items", [])) >= 3:
        print("fresh: today's news is already cached")
        return 0
    os.makedirs(DIR, exist_ok=True)
    items = build()
    if len(items) < 3:
        log("viii-news: only %d usable items, keeping the old cache" % len(items))
        keep = set(os.path.basename(i.get("img", "")) for i in (old or {}).get("items", []))
        prune(keep)
        return 1
    tmp = OUT + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"date": today, "ts": int(time.time()), "items": items}, f, ensure_ascii=False)
    os.replace(tmp, OUT)
    prune(set(os.path.basename(i["img"]) for i in items))
    print("ok: %d items cached for %s" % (len(items), today))
    return 0


if __name__ == "__main__":
    sys.exit(main())
