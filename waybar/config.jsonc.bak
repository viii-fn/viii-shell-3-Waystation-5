{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,

    "modules-left": ["custom/launcher", "wlr/taskbar", "group/media"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],

    "custom/launcher": {
        "format": "🏜️",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 Muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰤭 Offline"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    
    "group/media": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "mpris", "custom/media-next"]
    },
    
    "custom/media-prev": {
        "format": "\uf048",               // backward icon
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    
    "custom/media-next": {
        "format": "\uf051",               // forward icon
        "tooltip": false,
        "on-click": "playerctl next"
    },
    
    "mpris": {
        "format": "{status_icon}  {artist} - {title}",
        "format-stopped": "",             // empty format hides the text when nothing plays
        "status-icons": {
            "playing": "\uf04b",          // play icon
            "paused": "\uf04c"            // pause icon
        },
        "max-length": 40,
        "ellipsis": "…",
        "tooltip-format": "{player}: {album}",
        "on-click": "play-pause",         // left click toggles play/pause
        "on-click-right": "next",
        "on-click-middle": "previous"
    }
}
