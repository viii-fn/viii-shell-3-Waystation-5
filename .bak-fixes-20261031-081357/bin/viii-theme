#!/usr/bin/env bash
# viii-theme [image | --random] [--shell-only]
#   image        theme everything from this wallpaper (shell + kitty + fish + GTK)
#   --random     pick a random file from ~/Pictures/Wallpapers
#   --shell-only only the shell colours (~/.cache/viii/theme.json)
#   (no image)   reuse the last wallpaper
set -u
P="$HOME/viii-shell-3"
W="$HOME/Pictures/Wallpapers"
S="$HOME/.local/state/viii"
mkdir -p "$S" "$HOME/.cache/viii" "$HOME/.config/kitty" "$HOME/.config/fish/conf.d" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"

img=""; cfg="config.toml"
for a in "$@"; do
  case "$a" in
    --shell-only) cfg="config-shell.toml" ;;
    --random) img="$(find "$W" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n1)" ;;
    -*) echo "usage: viii-theme [image|--random] [--shell-only]"; exit 2 ;;
    *) img="$a" ;;
  esac
done
[ -n "$img" ] || img="$(cat "$S/wallpaper" 2>/dev/null || true)"
[ -f "$img" ] || { echo "viii-theme: no image (give a path, or --random)"; exit 1; }
img="$(readlink -f "$img")"

matugen --config "$P/matugen/$cfg" image "$img" --mode dark --prefer saturation || { echo "viii-theme: matugen failed (nothing changed)"; exit 1; }
grep -q '"primary": "#' "$HOME/.cache/viii/theme.json" 2>/dev/null || { echo "viii-theme: theme.json has no colours: template syntax problem"; exit 1; }

printf '%s\n' "$img" > "$S/wallpaper"
[ "$cfg" = "config.toml" ] && pkill -USR1 -x kitty 2>/dev/null
if [ "$cfg" = "config.toml" ]; then
  # border colours for Hyprland; if matugen did not render it properly, drop it so look.lua keeps its defaults
  grep -Eq 'rgba\([0-9a-fA-F]{6}ee\)' "$HOME/.cache/viii/hypr-colors.lua" 2>/dev/null || { rm -f "$HOME/.cache/viii/hypr-colors.lua"; echo "viii-theme: hypr-colors.lua not rendered (borders keep the default)"; }
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl reload >/dev/null 2>&1
fi
echo "viii-theme: themed from $img"
